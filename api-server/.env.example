COINJECTURE_API_HOST=0.0.0.0
COINJECTURE_API_PORT=3030
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_EXPIRY_SECONDS=86400
RATE_LIMIT_RPS=100
RUST_LOG=info
COINJECTURE_NETWORK=testnet
# Upstream JSON-RPC for /chain/info, /node-rpc, indexer.
# Default on docker-compose: http://bootnode:9933 (api-server and bootnode on `coinject-rpc`).
NODE_RPC_URL=http://bootnode:9933
