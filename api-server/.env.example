COINJECTURE_API_HOST=0.0.0.0
COINJECTURE_API_PORT=3030
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_EXPIRY_SECONDS=86400
RATE_LIMIT_RPS=100
RUST_LOG=info
COINJECTURE_NETWORK=testnet
# Upstream JSON-RPC for /chain/info, /node-rpc, indexer.
# Default on docker-compose: http://bootnode:9933 (api-server and bootnode on `coinject-rpc`).
NODE_RPC_URL=http://bootnode:9933
# Optional comma-separated browser origins (e.g. CloudFront): https://dxxx.cloudfront.net
# CORS_EXTRA_ORIGINS=

# Hugging Face — consumed by coinject **nodes** (docker `.env` / compose), not by this binary.
# Listed here so one file can be copied to the host `.env` next to docker-compose.
# HUGGINGFACE_TOKEN=
# HF_TOKEN=
# HF_DATASET_NAME=COINjecture/NP-Solutions
