COINJECTURE_API_HOST=0.0.0.0
COINJECTURE_API_PORT=3030
SUPABASE_URL=https://zmaodanzkfabhvmjiccr.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_JWT_SECRET=your-jwt-secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
JWT_EXPIRY_SECONDS=86400
RATE_LIMIT_RPS=100
RUST_LOG=info
COINJECTURE_NETWORK=testnet
# Upstream JSON-RPC for /chain/info, /node-rpc, indexer.
# Docker default: node1 first (bootnode RPC can hang under fork/sync load), then bootnode.
# Production: https://api.coinjecture.com must reach a healthy node (not a stale public RPC).
# bootnode second (fast failover for chain_getInfo); node1 first so transaction_submit hits miner mempool
NODE_RPC_URL=http://node1:9933,http://bootnode:9933
# Tried first for chain_getMiningWork only (bootnode often has mining disabled in node1-only-mine overlay)
MINING_RPC_URL=http://node1:9933
# Optional comma-separated browser origins (e.g. CloudFront): https://dxxx.cloudfront.net
# CORS_EXTRA_ORIGINS=

# Hugging Face — consumed by coinject **nodes** (docker `.env` / compose), not by this binary.
# Listed here so one file can be copied to the host `.env` next to docker-compose.
# HUGGINGFACE_TOKEN=
# HF_TOKEN=
# HF_DATASET_NAME=COINjecture/NP-Solutions
# If `datasets.load_dataset` fails with SplitInfo / UnexpectedError, refresh Hub root `dataset_infos.json`
# from `huggingface/dataset_infos.json` (see `scripts/hf_np_solutions_emit_dataset_infos.py`).
