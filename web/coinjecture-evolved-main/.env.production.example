# Loaded automatically by `vite build` / `npm run build` (not committed).
# Copy to `.env.production` before deploying the static site.

# Required: auth, GET /chain/info, and (by default) browser JSON-RPC via POST /node-rpc on this host
# (API forwards to NODE_RPC_URL — no http://localhost:9933 in the static bundle).
VITE_API_URL=https://api.coinjecture.com

# Public Hugging Face dataset page (hero + links). Must match the repo nodes upload to (HF_DATASET_NAME).
VITE_HF_DATASET_URL=https://huggingface.co/datasets/COINjecture/NP-Solutions

# Optional: comma-separated HTTPS public RPC URLs for multi-node / direct RPC. If unset, the app uses
# VITE_API_URL + /node-rpc. If you set http:// or localhost here, production HTTPS builds still use /node-rpc.
# VITE_RPC_URL=https://rpc1.coinjecture.com

# Optional: marketplace *export* REST service (catalog mirror on /marketplace page). Static hosting has no proxy;
# use a full HTTPS origin if you run the export API. Dev uses Vite proxy /marketplace → 8080 without this.
# VITE_MARKETPLACE_EXPORT_URL=https://export.example.com

# Optional: Prometheus scrape URL for /explore metrics (defaults to same-origin /metrics; set for split hosting).
# VITE_METRICS_URL=https://metrics.example.com/metrics

# Optional: Meta/Facebook App ID (numeric). Clears Sharing Debugger "missing fb:app_id" warning.
# Create a free app at https://developers.facebook.com/apps/ (use case: Other), add coinjecture.com
# under App Domains / Website, then paste the App ID here. Build replaces the default placeholder.
# VITE_FB_APP_ID=1234567890123456
